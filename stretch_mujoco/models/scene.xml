<mujoco model="stretch scene">
  <include file="stretch.xml"/>
  <include file="docking_station.xml"/>

  <statistic center="0 0 .75" extent="1.2" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-120" elevation="-20"/>
  </visual>

  <asset>
    <material name="floor" rgba=".1 .1 .1 1" reflectance="0.1"/>
    <texture type="2d" name="wood" file="wood.png"/>
    <material name="wood" texture="wood"/>
    <material name="object" rgba=".2 .2 .2 1"/>
    <texture type="skybox" builtin="gradient" rgb1="0.44 0.80 1.00" rgb2="1 1 1" width="512" height="3072"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="floor"/>

    <!-- Raised platform so the block sits at gripper height -->
    <body name="blue_table" pos="1.20 0.0 0.25">
      <geom type="box"
            size="0.25 0.25 0.10"
            mass="5.0"
            rgba="0.2 0.2 0.2 1.0"
            contype="1"
            conaffinity="1"/>
    </body>

    <!-- Graspable block sized for Stretch gripper (must remain top-level for free joint) -->
    <body name="big_object" pos="1.20 0.0 0.40">
      <freejoint/>
      <geom type="box"
            size="0.04 0.025 0.05"
            mass="0.8"
            rgba="0.1 0.6 0.9 1"
            contype="1"
            conaffinity="1"/>
    </body>

  <body name="obstacle" pos="0.35 0.25 0.15">
    <freejoint/>
    <geom type="cylinder"
          size="0.10 0.15"
          mass="2.0"
          rgba="0.9 0.3 0.3 1"/>
  </body>
  </worldbody>
</mujoco>
