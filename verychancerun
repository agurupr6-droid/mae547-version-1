# --- IK: end-effector pose -> joint config -----------------------------------

def ik_solve(
    sim: StretchMujocoSimulator,
    target_pose: np.ndarray,
    q_seed: np.ndarray,
    max_iters: int = 80,
    step_size: float = 0.08,
    tol: float = 1e-3,
) -> np.ndarray | None:
    """
    Very simple Jacobian-free numerical IK:
    repeatedly adjust q to reduce (x, y, theta) error using FK.

    target_pose: np.array([x, y, theta])
    q_seed:      initial guess
    """
    q = arm_q_clamp(q_seed)

    for _ in range(max_iters):
        current = fk_end_effector(sim, q)
        err = target_pose - current
        err[2] = wrap_angle(err[2])  # normalize heading error

        if np.linalg.norm(err) < tol:
            return arm_q_clamp(q)

        # Approximate gradient w.r.t each joint using finite differences
        grad = np.zeros_like(q)
        eps = 1e-3
        for i in range(len(q)):
            q_pert = q.copy()
            q_pert[i] += eps
            pose_pert = fk_end_effector(sim, q_pert)
            delta_pose = pose_pert - current
            delta_pose[2] = wrap_angle(delta_pose[2])
            # project pose change onto error
            grad[i] = float(np.dot(delta_pose, err) / (eps + 1e-9))

        # Gradient descent step
        q += step_size * grad
        q = arm_q_clamp(q)

    # Did not converge
    return None


