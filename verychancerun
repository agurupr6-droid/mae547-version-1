def set_arm_configuration(sim: StretchMujocoSimulator, q: np.ndarray, blocking: bool = False) -> None:
    """
    Command arm joints to configuration q.

    This uses sim.move_to() which you already use in run_manipulation_sequence.
    """
    q = arm_q_clamp(q)
    for value, joint in zip(q, ARM_JOINT_ORDER):
        sim.move_to(joint, float(value))
    if blocking:
        for joint in ARM_JOINT_ORDER:
            sim.wait_until_at_setpoint(joint)


