# We'll plan in a small joint space for the arm.
# Here we use [lift, arm, wrist_yaw] as our configuration vector.
ARM_JOINT_ORDER = [Actuators.lift, Actuators.arm, Actuators.wrist_yaw]

# Conservative joint limits (adjust to match your robot)
ARM_JOINT_LIMITS = {
    Actuators.lift: (0.0, 1.1),
    Actuators.arm: (0.0, 0.8),
    Actuators.wrist_yaw: (-math.pi, math.pi),
}


def arm_q_clamp(q: np.ndarray) -> np.ndarray:
    """Clamp joint vector to limits."""
    q = q.copy()
    for i, joint in enumerate(ARM_JOINT_ORDER):
        lo, hi = ARM_JOINT_LIMITS[joint]
        q[i] = float(np.clip(q[i], lo, hi))
    return q


